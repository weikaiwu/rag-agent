# ===================== Python / 依赖 =====================
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ===================== 环境与密钥（绝不提交） =====================
.env
.env.*
!.env.example

# ===================== IDE =====================
.idea/
.vscode/
*.swp

# ===================== 运行时产物 =====================
logs/
output/
*.log

# ===================== 原始文档（体积较大，不入库） =====================
# 只忽略 doc/ 下的一级内容，这样 !doc/tech-notes/ 才能生效
# （若写成 doc/ ，整个目录被排除，目录内的否定规则不会再被 Git 读取）
doc/*
!doc/tech-notes/

# ===================== 系统 / 临时 =====================
.DS_Store
Thumbs.db

# ===================== 本地 Milvus Lite 嵌入式库（运行时生成物，含数据） =====================
app/import_process/agent/milvus_demo.db/
*.db
*.parquet
*.arrow

# ===================== 清理/修复脚本产物与临时数据 =====================
scripts/__pycache__/
