# ============================================================
# 环境变量模板 —— 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不会提交）
# ============================================================

# ---- MinerU（PDF 解析为 MD + 提取图片）----
MINERU_MODEL_SOURCE=local
MODELSCOPE_OFFLINE=true
MODELSCOPE_CACHE=./modelscope_cache
HF_HOME=./hf_cache
MD_ROOT_DIR=./output
MINERU_API_TOKEN=
MINERU_BASE_URL=

# ---- 大模型（LLM / 多模态）----
LLM_DEFAULT_MODEL=
VL_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_DEFAULT_TEMPERATURE=0.1
ITEM_NAME_DIAG=true

# ---- BGE-M3 嵌入 / Reranker ----
BGE_M3_PATH=
BGE_M3=true
BGE_FP16=true
BGE_RERANKER_LARGE=true
BGE_RERANKER_DEVICE=cuda
BGE_RERANKER_FP16=true

# ---- Milvus 向量库 ----
MILVUS_URL=http://127.0.0.1:19530
CHUNKS_COLLECTION=kb_chunks
ITEM_NAME_COLLECTION=kb_item_names
EMBEDDING_DIM=1024

# ---- MongoDB（对话历史）----
MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB_NAME=rag_agent

# ---- MinIO 对象存储（原始文件 + 提取图片）----
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=knowledge-base-files
MINIO_IMG_DIR=upload-images
MINIO_SECURE=false

# ---- MCP Web Search（联网检索）----
MCP_DASHSCOPE_BASE_URL=
MCP_DASHSCOPE_BASE_URL_STREAMABLE=

# ---- 日志 ----
LOG_CONSOLE_ENABLE=true
LOG_CONSOLE_LEVEL=INFO
LOG_FILE_ENABLE=true
LOG_FILE_LEVEL=DEBUG
LOG_FILE_RETENTION=7
